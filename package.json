{
  "name": "governance-apps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "worker:build": "opennextjs-cloudflare build",
    "worker:deploy": "opennextjs-cloudflare deploy -- --keep-vars",
    "worker:deploy:preprod": "opennextjs-cloudflare deploy -c wrangler.preprod.jsonc -- --keep-vars",
    "worker:deploy:prod": "opennextjs-cloudflare deploy -c wrangler.jsonc -- --keep-vars",
    "worker:upload": "opennextjs-cloudflare upload -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:dao-feed": "node ./scripts/generate-dao-feed-v1.mjs",
    "test:e2e": "playwright test --project=smoke --workers=1",
    "test:e2e:full": "playwright test --project=full",
    "check:veyfi-apr": "node ./scripts/check-veyfi-base-apr.mjs",
    "validate:deps": "node ./scripts/validate-dependency-policy.mjs",
    "validate:prod-env": "node ./scripts/validate-prod-env.mjs",
    "validate:worker-size": "node ./scripts/check-worker-size.mjs",
    "agent:sync": "./scripts/sync-agent-env.sh",
    "agent:bootstrap": "./scripts/agent-worktree.sh"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.90.10",
    "clsx": "2.1.1",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.1",
    "multiformats": "14.0.5",
    "next": "16.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hot-toast": "2.6.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss-animate": "1.0.7",
    "viem": "2.55.11",
    "wagmi": "2.19.5",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.12.3",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "baseline-browser-mapping": "2.10.27",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "4.1.5",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "@coinbase/cdp-sdk": "1.52.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.14.0"
}
