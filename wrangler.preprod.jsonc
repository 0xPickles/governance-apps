{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "governance-apps-preprod",
  "main": ".open-next/worker.js",

  "compatibility_date": "2026-01-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "preview_urls": true,

  // Separate preproduction ledger. Never replace an existing release ledger with an empty database.
  "d1_databases": [{ "binding": "DAO_PUBLICATION_DB", "database_name": "dao-publication-preprod", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations/dao-publication" }],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },

  "routes": [
    { "pattern": "styfi-beta.dao-ops.com", "custom_domain": true },
    { "pattern": "veyfi-beta.dao-ops.com", "custom_domain": true },
    { "pattern": "teams-beta.dao-ops.com", "custom_domain": true },
    { "pattern": "yeth-beta.dao-ops.com", "custom_domain": true },
    { "pattern": "ybc-beta.dao-ops.com", "custom_domain": true },
    { "pattern": "dao-beta.dao-ops.com", "custom_domain": true }
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "governance-apps-preprod"
    }
  ]
}
