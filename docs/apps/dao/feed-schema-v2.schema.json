{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "yearn.dao.feed.v2"
    },
    "chainId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "observedAt": {
      "$ref": "#/definitions/__schema0"
    },
    "block": {
      "type": "object",
      "properties": {
        "number": {
          "$ref": "#/definitions/__schema1"
        },
        "hash": {
          "$ref": "#/definitions/__schema2"
        },
        "timestamp": {
          "$ref": "#/definitions/__schema0"
        }
      },
      "required": [
        "number",
        "hash",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "deployments": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "votingAddress": {
            "$ref": "#/definitions/__schema3"
          },
          "proposalCount": {
            "$ref": "#/definitions/__schema1"
          },
          "configuration": {
            "type": "object",
            "properties": {
              "voteStart": {
                "$ref": "#/definitions/__schema1"
              },
              "executeDelay": {
                "$ref": "#/definitions/__schema1"
              },
              "executeGuard": {
                "type": "boolean"
              },
              "threshold": {
                "$ref": "#/definitions/__schema1"
              },
              "voter": {
                "$ref": "#/definitions/__schema3"
              },
              "executor": {
                "$ref": "#/definitions/__schema3"
              }
            },
            "required": [
              "voteStart",
              "executeDelay",
              "executeGuard",
              "threshold",
              "voter",
              "executor"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "votingAddress",
          "proposalCount",
          "configuration"
        ],
        "additionalProperties": false
      }
    },
    "proposals": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "votingAddress": {
            "$ref": "#/definitions/__schema3"
          },
          "id": {
            "$ref": "#/definitions/__schema1"
          },
          "proposer": {
            "$ref": "#/definitions/__schema3"
          },
          "epoch": {
            "$ref": "#/definitions/__schema1"
          },
          "contentDigest": {
            "$ref": "#/definitions/__schema2"
          },
          "scriptHash": {
            "$ref": "#/definitions/__schema2"
          },
          "threshold": {
            "$ref": "#/definitions/__schema1"
          },
          "votes": {
            "$ref": "#/definitions/__schema1"
          },
          "yea": {
            "$ref": "#/definitions/__schema1"
          },
          "retracted": {
            "type": "boolean"
          },
          "executed": {
            "type": "boolean"
          },
          "flagged": {
            "type": "boolean"
          },
          "vetoed": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "PROPOSED",
              "RETRACTED",
              "VOTING",
              "PASSED",
              "FAILED",
              "EXECUTED",
              "EXPIRED",
              "FLAGGED",
              "VETOED"
            ]
          },
          "scriptBytes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4098,
                "pattern": "^0x(?:[0-9a-f]{2})*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "contentBytes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 174764
              },
              {
                "type": "null"
              }
            ]
          },
          "events": {
            "minItems": 1,
            "maxItems": 100000,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "propose"
                    },
                    "log": {
                      "$ref": "#/definitions/__schema4"
                    }
                  },
                  "required": [
                    "type",
                    "log"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "retract"
                    },
                    "log": {
                      "$ref": "#/definitions/__schema4"
                    }
                  },
                  "required": [
                    "type",
                    "log"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "flag"
                    },
                    "log": {
                      "$ref": "#/definitions/__schema4"
                    },
                    "reason": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "type",
                    "log",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "veto"
                    },
                    "log": {
                      "$ref": "#/definitions/__schema4"
                    },
                    "reason": {
                      "type": "string",
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "type",
                    "log",
                    "reason"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "execute"
                    },
                    "log": {
                      "$ref": "#/definitions/__schema4"
                    },
                    "executor": {
                      "$ref": "#/definitions/__schema3"
                    }
                  },
                  "required": [
                    "type",
                    "log",
                    "executor"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "vote"
                    },
                    "log": {
                      "$ref": "#/definitions/__schema4"
                    },
                    "account": {
                      "$ref": "#/definitions/__schema3"
                    },
                    "weight": {
                      "$ref": "#/definitions/__schema1"
                    },
                    "yea": {
                      "$ref": "#/definitions/__schema1"
                    }
                  },
                  "required": [
                    "type",
                    "log",
                    "account",
                    "weight",
                    "yea"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "votingAddress",
          "id",
          "proposer",
          "epoch",
          "contentDigest",
          "scriptHash",
          "threshold",
          "votes",
          "yea",
          "retracted",
          "executed",
          "flagged",
          "vetoed",
          "status",
          "scriptBytes",
          "contentBytes",
          "events"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "chainId",
    "observedAt",
    "block",
    "deployments",
    "proposals"
  ],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "__schema1": {
      "type": "string",
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "blockNumber": {
          "$ref": "#/definitions/__schema1"
        },
        "blockHash": {
          "$ref": "#/definitions/__schema2"
        },
        "timestamp": {
          "$ref": "#/definitions/__schema0"
        },
        "transactionHash": {
          "$ref": "#/definitions/__schema2"
        },
        "transactionIndex": {
          "$ref": "#/definitions/__schema5"
        },
        "logIndex": {
          "$ref": "#/definitions/__schema5"
        }
      },
      "required": [
        "blockNumber",
        "blockHash",
        "timestamp",
        "transactionHash",
        "transactionIndex",
        "logIndex"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$id": "yearn.dao.feed.v2",
  "title": "Yearn DAO feed V2"
}
